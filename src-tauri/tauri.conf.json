{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.3.0",
  "identifier": "com.growthforging.folio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Folio",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 440,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdx", "mdown"], "name": "Markdown Document", "role": "Editor" },
      { "ext": ["json", "jsonc", "geojson"], "name": "JSON Document", "role": "Editor" },
      { "ext": ["csv", "tsv"], "name": "Delimited Text", "role": "Editor" }
    ]
  }
}
